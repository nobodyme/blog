---
import { getCollection } from "astro:content"
import Binoculars from "../components/Binoculars.astro"
import Layout from "../layouts/Layout.astro"
import { excerpt, formatDate } from "../lib/text.js"
import { site, url } from "../site.js"

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: site.title,
  description: site.description,
  url: site.siteUrl,
  author: { "@type": "Person", name: site.author.name, url: site.author.url },
  blogPost: posts.map(post => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    url: new URL(`${post.id}/`, site.siteUrl).href,
    datePublished: post.data.date.toISOString(),
  })),
}
---

<Layout jsonLd={jsonLd}>
  {
    posts.length === 0 ? (
      <p>No blog posts found.</p>
    ) : (
      <>
      {/* The home page's binoculars live here, large; every other page has them in the header. */}
      <section class="home-hero">
        <div>
          <h1 class="home-hero-title">
            Hi, I'm{" "}
            <a href={site.author.url} target="_blank" rel="noopener noreferrer">Naveen</a>.
          </h1>
          <p class="home-hero-tagline">{site.description}</p>
        </div>
        <Binoculars class="home-hero-mascot" width={150} height={120} />
      </section>
      <hr class="home-hero-rule" />
      <ol class="post-list">
        {posts.map(post => (
          <li class="post-list-item">
            <article>
              <header>
                <h2>
                  <a href={url(`${post.id}/`)}>
                    {post.data.title || post.id}
                  </a>
                </h2>
                <small class="meta">{formatDate(post.data.date)}</small>
              </header>
              <section>
                {/* A frontmatter description may contain HTML (as with Gatsby); the
                    generated excerpt is plain text and must stay escaped. */}
                {post.data.description ? (
                  <p class="post-description" set:html={post.data.description} />
                ) : (
                  <p class="post-description">
                    {excerpt(post)}
                  </p>
                )}
              </section>
            </article>
          </li>
        ))}
      </ol>
      </>
    )
  }
</Layout>
