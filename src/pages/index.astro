---
import { getCollection } from "astro:content"
import Layout from "../layouts/Layout.astro"
import { excerpt, formatDate } from "../lib/text.js"
import { site, url } from "../site.js"

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: site.title,
  description: site.description,
  url: site.siteUrl,
  author: { "@type": "Person", name: site.author.name, url: site.author.url },
  blogPost: posts.map(post => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    url: new URL(`${post.id}/`, site.siteUrl).href,
    datePublished: post.data.date.toISOString(),
  })),
}
---

<Layout jsonLd={jsonLd}>
  {
    posts.length === 0 ? (
      <p>No blog posts found.</p>
    ) : (
      <>
      <div style="margin-bottom: 20px">
        <h3 style="margin-top: 0px">
          <a href="https://www.linkedin.com/in/naveen-kumar-b11464128/" target="_blank" rel="noopener noreferrer">
            Hi, I'm Naveen
          </a>{" "}
          👋
        </h3>
        <div class="post-description" style="margin-bottom: 20px">{site.description}</div>
        <hr />
      </div>
      <ol class="post-list">
        {posts.map(post => (
          <li class="post-list-item">
            <article>
              <header>
                <h2>
                  <a href={url(`${post.id}/`)}>
                    {post.data.title || post.id}
                  </a>
                </h2>
                <small class="meta">{formatDate(post.data.date)}</small>
              </header>
              <section>
                {/* A frontmatter description may contain HTML (as with Gatsby); the
                    generated excerpt is plain text and must stay escaped. */}
                {post.data.description ? (
                  <p class="post-description" set:html={post.data.description} />
                ) : (
                  <p class="post-description">
                    {excerpt(post)}
                  </p>
                )}
              </section>
            </article>
          </li>
        ))}
      </ol>
      </>
    )
  }
</Layout>
