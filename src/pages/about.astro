---
import Github from "../assets/svg/github.svg"
import LinkedIn from "../assets/svg/linkedin.svg"
import Rss from "../assets/svg/rss.svg"
import Binoculars from "../components/Binoculars.astro"
import Layout from "../layouts/Layout.astro"
import { site, url } from "../site.js"

const github = "https://github.com/nobodyme"

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: new URL("about/", site.siteUrl).href,
  mainEntity: {
    "@type": "Person",
    name: site.author.name,
    url: site.author.url,
    description: site.description,
    sameAs: [github, site.author.url],
  },
}
---

<Layout title="About" description={site.description} jsonLd={jsonLd}>
  <section class="about">
    <Binoculars id="bino-about" class="about-mascot" width={150} height={120} />
    <div>
      <h1 class="about-title">Hi, I'm {site.author.name}.</h1>
      <p class="about-lede">{site.description}.</p>
      <p>
        I write about the parts of building systems that surprised me: rolling features out to a percentage of users,
        splitting CloudFormation stacks, fine-tuning a model for the AWS AI League, and generating lyric videos with AI.
      </p>
      <p>
        If something here helps, or you think I got it wrong, the comments under each post go straight to GitHub
        Discussions.
      </p>
      <ul class="about-links">
        <li>
          <a href={github} target="_blank" rel="noopener noreferrer">
            <Github width={20} height={20} aria-hidden="true" />GitHub
          </a>
        </li>
        <li>
          <a href={site.author.url} target="_blank" rel="noopener noreferrer">
            <LinkedIn width={20} height={20} aria-hidden="true" />LinkedIn
          </a>
        </li>
        <li>
          <a href={url("rss.xml")} target="_blank" rel="noopener noreferrer">
            <Rss width={18} height={18} aria-hidden="true" />RSS
          </a>
        </li>
      </ul>
    </div>
  </section>
</Layout>
