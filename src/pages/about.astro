---
import Github from "../assets/svg/github.svg"
import LinkedIn from "../assets/svg/linkedin.svg"
import X from "../assets/svg/x.svg"
import Binoculars from "../components/Binoculars.astro"
import Layout from "../layouts/Layout.astro"
import { site } from "../site.js"

const github = "https://github.com/nobodyme"
const x = `https://x.com/${site.social.twitter}`

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: new URL("about/", site.siteUrl).href,
  mainEntity: {
    "@type": "Person",
    name: site.author.name,
    url: site.author.url,
    description: site.description,
    sameAs: [github, site.author.url, x],
  },
}
---

<Layout title="About" description={site.description} jsonLd={jsonLd}>
  <section class="about">
    <Binoculars id="bino-about" class="about-mascot" width={150} height={120} />
    <div>
      <h1 class="about-title">Hi, I'm {site.author.name}.</h1>
      <p class="about-lede">{site.description}.</p>
      {/* TODO: a few lines about me and what I write about. Left empty for now. */}
      <ul class="about-links">
        <li>
          <a href={github} target="_blank" rel="noopener noreferrer">
            <Github width={20} height={20} aria-hidden="true" />GitHub
          </a>
        </li>
        <li>
          <a href={site.author.url} target="_blank" rel="noopener noreferrer">
            <LinkedIn width={20} height={20} aria-hidden="true" />LinkedIn
          </a>
        </li>
        <li>
          <a href={x} target="_blank" rel="noopener noreferrer">
            <X width={18} height={18} aria-hidden="true" />X
          </a>
        </li>
      </ul>
    </div>
  </section>
</Layout>
