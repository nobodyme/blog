---
import DailyDay from "../../components/DailyDay.astro"
import Layout from "../../layouts/Layout.astro"
import { getDays, shortDate } from "../../lib/daily"

export async function getStaticPaths() {
  // Newest first: the day before is the next entry, the day after the previous one.
  const days = await getDays()
  return days.map((day, i) => ({
    params: { date: day.date },
    props: { day, older: days[i + 1], newer: days[i - 1] },
  }))
}

const { day, older, newer } = Astro.props
---

<Layout title={`AI news, ${shortDate(day.date)}`} description={day.items[0].headline}>
  <DailyDay day={day} older={older} newer={newer} />
</Layout>
