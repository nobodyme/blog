---
// Giscus comments, mapped to GitHub Discussions by page pathname (unchanged).
---

<div class="comment-container">
  <h4>Comments</h4>
  <p>
    Want to share feedback, or discuss further ideas? Feel free to leave a comment here! This comment thread directly
    maps to a <a href="https://github.com/nobodyme/blog/discussions/categories/post-comments">discussion on GitHub</a>,
    so you can also comment there if you prefer.
  </p>
  <div class="giscus"></div>
</div>
<script is:inline>
  // Giscus is loaded here (not with a static <script>) so it starts in the theme the
  // page is showing: the header toggle's saved choice, or the system theme. The toggle
  // updates it later with a postMessage.
  ;(function () {
    var picked = document.documentElement.dataset.theme
    var s = document.createElement("script")
    var attrs = {
      src: "https://giscus.app/client.js",
      id: "giscus-script",
      "data-repo": "nobodyme/blog",
      "data-repo-id": "MDEwOlJlcG9zaXRvcnkzNjU3NTQxMTI=",
      "data-category-id": "DIC_kwDOFcz3AM4CA8kh",
      "data-mapping": "pathname",
      "data-theme": picked === "light" || picked === "dark" ? picked : "preferred_color_scheme",
      "data-reactions-enabled": "1",
      "data-emit-metadata": "0",
      "data-input-position": "top",
      "data-lang": "en",
      // The comments iframe loads only when it's scrolled near, not with the page.
      "data-loading": "lazy",
      crossorigin: "anonymous",
    }
    for (var k in attrs) s.setAttribute(k, attrs[k])
    s.async = true
    document.currentScript.after(s)

    // A theme toggled before the lazy iframe loaded never reached it, so send the
    // current theme once giscus first talks to the page (its first height update).
    addEventListener("message", function sendTheme(e) {
      if (e.origin !== "https://giscus.app" || !e.data || !e.data.giscus) return
      removeEventListener("message", sendTheme)
      var root = document.documentElement
      var theme = root.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
      e.source.postMessage({ giscus: { setConfig: { theme: theme } } }, "https://giscus.app")
    })
  })()
</script>
