---
import Github from "../assets/svg/github.svg"
import Heart from "../assets/svg/heart.svg"
import LinkedIn from "../assets/svg/linkedin.svg"
import Rss from "../assets/svg/rss.svg"
import { url } from "../site.js"

interface Props {
  siteTitle: string
}

const { siteTitle } = Astro.props

// Lens centres in the binoculars' 100 x 64 drawing.
const lenses = [
  { side: "l", cx: 29 },
  { side: "r", cx: 71 },
]
---

<div class="global-header">
  <a class="header-title" href={url()}>
    <svg class="header-icon binoculars" viewBox="0 0 100 64" width="44" height="28" aria-hidden="true" focusable="false">
      <defs>
        {
          lenses.map(({ side, cx }) => (
            <>
              <clipPath id={`bino-glass-${side}`}>
                <circle cx={cx} cy="45" r="13" />
              </clipPath>
              <mask id={`bino-smile-${side}`} maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="70">
                <rect width="100" height="70" fill="#fff" />
                <path
                  class="bino-cheek"
                  fill="#000"
                  transform="translate(0 7)"
                  d={`M${cx - 15} 62V52Q${cx} 42 ${cx + 15} 52V62Z`}
                />
              </mask>
            </>
          ))
        }
      </defs>
      <g class="bino-frame">
        <rect x="21" y="3" width="16" height="13" rx="4" />
        <rect x="63" y="3" width="16" height="13" rx="4" />
        <rect x="45" y="11" width="10" height="9" rx="2" />
        <path d="M12 45C12 31 16 21 20 14H38C42 21 46 31 46 45Z" />
        <path d="M54 45C54 31 58 21 62 14H80C84 21 88 31 88 45Z" />
        <rect x="40" y="22" width="20" height="12" rx="3" />
        <circle cx="29" cy="45" r="17" />
        <circle cx="71" cy="45" r="17" />
      </g>
      {
        lenses.map(({ side, cx }) => (
          <g clip-path={`url(#bino-glass-${side})`}>
            <circle class="bino-glass" cx={cx} cy="45" r="13" />
            <g mask={`url(#bino-smile-${side})`}>
              <g class="bino-eye">
                <circle class="bino-pupil" cx={cx} cy="45" r="7.6" />
                <circle class="bino-sparkle" cx={cx - 2.7} cy="42.2" r="2.5" />
                <circle class="bino-sparkle" cx={cx + 2.6} cy="47.8" r="1.1" />
              </g>
            </g>
            <ellipse
              class="bino-shine"
              cx={cx - 5}
              cy="40"
              rx="3.8"
              ry="2.1"
              transform={`rotate(-38 ${cx - 5} 40)`}
            />
            <g class="bino-blush-group" transform="translate(0 7)">
              <ellipse class="bino-blush" cx={cx + (cx < 50 ? -6.5 : 6.5)} cy="54.5" rx="3.6" ry="1.9" />
            </g>
            <path class="bino-lash" d={`M${cx - 7} 44.5Q${cx} 51 ${cx + 7} 44.5`} />
          </g>
        ))
      }
    </svg>
    <h3 class="header-text">{siteTitle}</h3>
  </a>
  <div class="header-social">
    <a class="header-social-link" href={url("liked-posts/")}>
      <Heart class="header-social-icon" width={35} height={35} />
    </a>
    <a
      class="header-social-link"
      href="https://www.linkedin.com/in/naveen-kumar-b11464128/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <LinkedIn class="header-social-icon" width={30} height={30} />
    </a>
    <a class="header-social-link" href="https://github.com/nobodyme" target="_blank" rel="noopener noreferrer">
      <Github class="header-social-icon" width={30} height={30} />
    </a>
    <a class="header-social-link" href={url("rss.xml")} target="_blank" rel="noopener noreferrer">
      <Rss class="header-social-icon" width={28} height={28} />
    </a>
  </div>
</div>

<script>
  // "Wakes up" binoculars: the eyes say hello on load, doze off, and wake up
  // happily when the cursor comes near. The animation loop only runs while
  // something is moving, and never while the header is off-screen.
  const svg = document.querySelector<SVGSVGElement>(".binoculars")

  if (svg) {
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)")
    const all = <T extends Element>(selector: string) => Array.from(svg.querySelectorAll<T>(selector))
    const eyes = all<SVGGElement>(".bino-eye")
    const cheeks = all<SVGPathElement>(".bino-cheek")
    const blushes = all<SVGGElement>(".bino-blush-group")
    const lashes = all<SVGPathElement>(".bino-lash")
    const lensX = [29, 71]
    const LENS_Y = 45
    const MAX_LOOK = 4.2 // how far an eye can move from the lens centre
    const AWAKE_MS = 2400 // stay awake this long after the cursor leaves
    const DROWSY_MS = 1800 // half-closed eyes before falling asleep
    const BLINK_MS = 170

    let pointer: { x: number; y: number } | null = null
    let onScreen = true
    let running = false
    const start = performance.now()
    let awakeUntil = start + 2800
    let delightUntil = start + 1100
    let wasAsleep = false
    let lid = 0
    let joy = 0.45
    let blinkAt = start + 2500 + Math.random() * 2500
    let blinkStart = -Infinity
    let idle = [0, 0]
    let idleAt = 0
    const look = [
      [0, 0],
      [0, 0],
    ]

    const hop = () => {
      if (reduceMotion.matches) return
      svg.classList.remove("bino-hop")
      void svg.getBoundingClientRect() // restart the CSS animation
      svg.classList.add("bino-hop")
    }
    svg.addEventListener("animationend", () => svg.classList.remove("bino-hop"))

    const tick = (t: number) => {
      const box = svg.getBoundingClientRect()
      const scale = box.width / 100
      const midX = box.left + box.width / 2
      const midY = box.top + box.height / 2
      const reach = Math.max(150, box.width * 1.4)
      const distance = pointer ? Math.hypot(pointer.x - midX, pointer.y - midY) : Infinity
      const rm = reduceMotion.matches

      if (distance < reach) awakeUntil = t + AWAKE_MS
      const lidTarget = t < awakeUntil ? 0 : t < awakeUntil + DROWSY_MS ? 0.55 : 1
      const asleep = lidTarget === 1
      if (wasAsleep && lidTarget === 0) {
        delightUntil = t + 1100
        hop()
      }
      wasAsleep = lid > 0.6

      // Smile at rest, smile more as the cursor gets close, squint with joy on waking.
      let joyTarget = 0.45 + 0.3 * Math.max(0, 1 - distance / reach)
      if (t < delightUntil) joyTarget = 1
      if (lidTarget > 0) joyTarget = 0
      joy += (joyTarget - joy) * 0.12

      if (!pointer && t > idleAt) {
        idleAt = t + 900 + Math.random() * 1700
        const angle = Math.random() * Math.PI * 2
        const amount = rm ? 0 : Math.random() * 4.2
        idle = [Math.cos(angle) * amount, Math.sin(angle) * amount * 0.7]
      }

      let settled = true
      for (let i = 0; i < 2; i++) {
        let tx: number
        let ty: number
        if (asleep) {
          tx = 0
          ty = 2.5
        } else if (pointer) {
          const dx = pointer.x - (box.left + lensX[i] * scale)
          const dy = pointer.y - (box.top + LENS_Y * scale)
          const d = Math.hypot(dx, dy) || 1
          const m = MAX_LOOK * (1 - Math.exp(-d / (60 + 40 * scale)))
          tx = (dx / d) * m
          ty = (dy / d) * m
        } else {
          ;[tx, ty] = idle
        }
        const ease = pointer ? 0.3 : 0.2
        look[i][0] += (tx - look[i][0]) * ease
        look[i][1] += (ty - look[i][1]) * ease
        if (Math.abs(tx - look[i][0]) > 0.01 || Math.abs(ty - look[i][1]) > 0.01) settled = false

        const cheekShift = `translate(0 ${((1 - joy) * 13).toFixed(2)})`
        cheeks[i].setAttribute("transform", cheekShift)
        blushes[i].setAttribute("transform", cheekShift)
        blushes[i].style.opacity = Math.max(0, (joy - 0.55) * 1.8).toFixed(2)
      }

      lid += (lidTarget - lid) * (lidTarget > lid ? 0.06 : 0.3)
      if (!asleep && t > blinkAt) {
        blinkStart = t
        blinkAt = t + (Math.random() < 0.2 ? 240 + Math.random() * 80 : 2600 + Math.random() * 3900)
      }
      const p = (t - blinkStart) / BLINK_MS
      const blink = !rm && p >= 0 && p <= 1 ? Math.sin(Math.PI * p) : 0
      // Eyes close by squashing flat; a closed-eye curve fades in as they shut.
      const shut = Math.min(1, Math.max(lid, blink))
      const open = Math.max(0.001, 1 - shut)
      for (let i = 0; i < 2; i++) {
        // Move the eye, and squash it vertically around its own centre.
        const [x, y] = look[i]
        eyes[i].setAttribute(
          "transform",
          `translate(${x.toFixed(2)} ${(LENS_Y * (1 - open) + y).toFixed(2)}) scale(1 ${open.toFixed(3)})`,
        )
        lashes[i].style.opacity = Math.min(1, Math.max(0, (shut - 0.6) / 0.35)).toFixed(2)
      }

      // Fully asleep and still: stop until the cursor comes back.
      const done = asleep && lid > 0.995 && joy < 0.005 && settled
      if (done || !onScreen) {
        running = false
        return
      }
      requestAnimationFrame(tick)
    }

    const run = () => {
      if (running || !onScreen) return
      running = true
      requestAnimationFrame(tick)
    }

    const isNear = (x: number, y: number) => {
      const box = svg.getBoundingClientRect()
      return Math.hypot(x - (box.left + box.width / 2), y - (box.top + box.height / 2)) < Math.max(150, box.width * 1.4)
    }

    const onPointer = (e: PointerEvent) => {
      pointer = { x: e.clientX, y: e.clientY }
      if (running) return
      if (isNear(e.clientX, e.clientY)) run()
    }
    addEventListener("pointermove", onPointer, { passive: true })
    addEventListener("pointerdown", onPointer, { passive: true })
    document.documentElement.addEventListener("mouseleave", () => {
      pointer = null
    })

    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting
      if (onScreen) run() // tick() stops itself straight away if there is nothing to animate
    }).observe(svg)

    hop()
    run()
  }
</script>
