---
interface Props {
  links: { label: string; url: string }[]
  lead?: string
}

const { links, lead = "Read more at" } = Astro.props
---

{
  links.length > 0 && (
    <p class="daily-cite">
      {lead}{" "}
      {links.map((link, i) => (
        <>
          {i > 0 && ", "}
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        </>
      ))}
    </p>
  )
}
