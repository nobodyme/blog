---
import "../normalize.css"
import "../index.css"
import "../style.css"

import Header from "../components/Header.astro"
import Seo from "../components/Seo.astro"
import { site, url } from "../site.js"

import type { ComponentProps } from "astro/types"

/** Page name (the site name is appended by <Seo>; omit on the home page) and share metadata. */
type Props = ComponentProps<typeof Seo>

const isRootPath = Astro.url.pathname === url()
const path = Astro.url.pathname
// Daily has no tab yet, so nothing is underlined there.
const section = path.startsWith(url("liked-posts"))
  ? "liked"
  : path.startsWith(url("about"))
    ? "about"
    : path.startsWith(url("daily"))
      ? undefined
      : "posts"
const iconSizes = [48, 72, 96, 144, 192, 256, 384, 512]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#24292e" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply the theme picked with the header toggle before anything is drawn,
      // so a saved choice never flashes the other theme. No choice: follow the system.
      try {
        var theme = localStorage.getItem("theme")
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
            m.content = theme === "dark" ? "#0d1117" : "#24292e"
          })
        }
      } catch (e) {}
    </script>
    <Seo {...Astro.props} />
    {
      import.meta.env.PROD && (
        <>
          <link rel="preconnect" href="https://www.googletagmanager.com" />
          <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.gtagId}`} />
          <script is:inline define:vars={{ id: site.gtagId }}>
            window.dataLayer = window.dataLayer || []
            function gtag() {
              dataLayer.push(arguments)
            }
            gtag("js", new Date())
            gtag("config", id)
          </script>
        </>
      )
    }
    <link rel="alternate" type="application/rss+xml" title={site.title} href={url("rss.xml")} />
    <link rel="icon" href={url("favicon-32x32.png")} type="image/png" />
    <link rel="manifest" href={url("manifest.webmanifest")} crossorigin="anonymous" />
    {
      iconSizes.map(s => (
        <link rel="apple-touch-icon" sizes={`${s}x${s}`} href={url(`icons/icon-${s}x${s}.png`)} />
      ))
    }
  </head>
  <body>
    <div>
      <Header siteTitle={site.title} current={section} isHome={isRootPath} />
      <div class="global-content-wrapper" data-is-root-path={String(isRootPath)}>
        <main><slot /></main>
      </div>
    </div>
  </body>
</html>

<script>
  // Fetch pages before they're opened, so they show at once: the header tabs as
  // soon as this page is up (a few KB each), any other page link the moment it's
  // pressed (touchstart / mousedown come ~100ms before the click).
  // Only where <link rel="prefetch"> works (Chrome, Edge, Firefox): iOS Safari
  // downloads a page again when it's opened even if fetch() just got it, so
  // there it would only cost data. The header's loading underline covers it.
  // Skipped with Save-Data or on 2G.
  {
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } })
      .connection
    const slow = connection?.saveData || /2g/.test(connection?.effectiveType ?? "")
    const supported = document.createElement("link").relList.supports?.("prefetch")
    const fetched = new Set([location.pathname])

    const prefetch = (link: HTMLAnchorElement | null) => {
      // Pages only (their URLs end in "/"), on this site, opening in this tab.
      if (!link || link.target || link.origin !== location.origin || !link.pathname.endsWith("/")) return
      if (fetched.has(link.pathname)) return
      fetched.add(link.pathname)
      const hint = document.createElement("link")
      hint.rel = "prefetch"
      hint.href = link.pathname
      document.head.append(hint)
    }

    if (supported && !slow) {
      document.querySelectorAll<HTMLAnchorElement>(".site-nav a").forEach(prefetch)
    }
    // Registered everywhere: a touchstart listener is also what lets iOS Safari
    // show :active (the press feedback on post cards and tabs).
    for (const type of ["touchstart", "mousedown"]) {
      document.addEventListener(
        type,
        e => {
          if (supported && !slow) prefetch((e.target as Element).closest("a"))
        },
        { passive: true },
      )
    }
  }
</script>
